<?xml version="1.0"?>
<!--
  World for PX4 SITL with the TB2-class airframe.

  Based on PX4's default.sdf (PX4-gazebo-models b6127f4): same home location
  and magnetic field. Sensor systems are listed explicitly because a world
  that declares any plugin does not get Gazebo's default system set.
  The TB2 model is included as "tb2_0" so PX4 can attach to it
  (PX4_GZ_STANDALONE=1, PX4_GZ_MODEL_NAME=tb2_0).
-->
<sdf version="1.9">
  <world name="tb2_runway">
    <physics name="4ms" type="ignored">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>
    <gravity>0 0 -9.80665</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type="adiabatic"/>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-air-pressure-system"
            name="gz::sim::systems::AirPressure"/>
    <plugin filename="gz-sim-navsat-system" name="gz::sim::systems::NavSat"/>
    <plugin filename="gz-sim-magnetometer-system"
            name="gz::sim::systems::Magnetometer"/>

    <scene>
      <grid>false</grid>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.8 0.9 1</background>
      <shadows>false</shadows>
    </scene>

    <light name="sun" type="directional">
      <pose>0 0 500 0 0 0</pose>
      <cast_shadows>false</cast_shadows>
      <direction>0.001 0.625 -0.78</direction>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.27 0.27 0.27 1</specular>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>10000 10000</size></plane></geometry>
        </collision>
        <visual name="grass">
          <geometry><plane><normal>0 0 1</normal><size>10000 10000</size></plane></geometry>
          <material><diffuse>0.35 0.55 0.3 1</diffuse></material>
        </visual>
        <!-- 1.2 km x 30 m runway along x (east), starting 100 m behind home -->
        <visual name="runway">
          <pose>500 0 0.01 0 0 0</pose>
          <geometry><box><size>1200 30 0.01</size></box></geometry>
          <material><diffuse>0.25 0.25 0.25 1</diffuse></material>
        </visual>
      </link>
    </model>

    <include>
      <uri>model://tb2</uri>
      <name>tb2_0</name>
      <!-- Wheel bottoms (1.15 m below the CG) just touching the ground,
           nose east along the runway -->
      <pose>0 0 1.16 0 0 0</pose>
    </include>

    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>47.397971057728974</latitude_deg>
      <longitude_deg>8.546163739800146</longitude_deg>
      <elevation>0</elevation>
    </spherical_coordinates>
  </world>
</sdf>