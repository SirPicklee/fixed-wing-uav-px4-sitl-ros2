# PX4 parameter overrides for the TB2-class airframe.
#
# PX4 v1.17 applies every PX4_PARAM_<NAME>=<value> environment variable at
# boot (ROMFS/px4fmu_common/init.d-posix/rcS), on top of the base airframe
# 4003_gz_rc_cessna. This keeps the PX4 source tree unmodified.
#
# Sourced by scripts/run_sitl.sh.

# --- SITL environment (see scripts/fly_mission.py) --------------------------
export PX4_PARAM_NAV_DLL_ACT=0       # no GCS in SITL
export PX4_PARAM_FW_LND_USETER=0     # no distance sensor on the model
export PX4_PARAM_FW_LND_ABORT=0

# --- Performance model, from fw_aero (tools/glide_trim.py, hand calcs) ------
# Stall: V_s = sqrt(2 W / (rho S CL_max)) = sqrt(2*6374/(1.225*11*1.4)) = 26 m/s
# Level flight at 45 m/s, sea level: CL = 0.467, CD = 0.0366, D = 500 N
# Thrust = 1800 N * thr * (1 - 0.012*45) = 828 N * thr  ->  thr = 0.60
export PX4_PARAM_FW_AIRSPD_STALL=26
export PX4_PARAM_FW_AIRSPD_MIN=32
export PX4_PARAM_FW_AIRSPD_TRIM=45
export PX4_PARAM_FW_AIRSPD_MAX=60
export PX4_PARAM_FW_THR_TRIM=0.6


# --- Navigation scaled to a 45 m/s aircraft ---------------------------------
# Loiter radius for a 30 deg bank at trim speed:
#   R = V^2 / (g tan 30deg) = 45^2 / (9.81 * 0.577) = 358 m  ->  400 m
# (PX4 default 80 m would need a 69 deg bank at 45 m/s.)
export PX4_PARAM_NAV_LOITER_RAD=400
export PX4_PARAM_NAV_ACC_RAD=60      # ~1.3 s at 45 m/s (default 15 m)
export PX4_PARAM_MIS_TAKEOFF_ALT=50


# --- Geometry and bank limit ------------------------------------------------
# Near the ground PX4 limits bank to ~2 h / span to avoid a wingtip strike
# (FixedWingModeManager::getMaxRollAngleNearGround). With the default 3 m
# span it allowed 40 deg at 1.9 m after liftoff; with 12 m it allows ~3 deg.
export PX4_PARAM_FW_WING_SPAN=12
export PX4_PARAM_FW_WING_HEIGHT=1.35  # wing above ground on the gear (SDF)
# Max bank: 35 deg (PX4 minimum) -> load factor 1.22 instead of 1.56 at 50 deg.
# Loiter at 400 m / 45 m/s needs atan(V^2/(g R)) = 27 deg.
export PX4_PARAM_FW_R_LIM=35


# --- Magnetometer: heading initialisation only ------------------------------
# Gazebo Harmonic's magnetometer system defaults to use_earth_frame_ned=true
# (gz-sim 8.15 Magnetometer.cc:141): the world field is computed in NED but
# used as an ENU vector. PX4 gz_bridge undoes this with a fixed axis swap,
# which is only exact for a level vehicle at Gazebo yaw 0 (nose east). In a
# 35 deg banked turn the EKF fused the wrong field, reset yaw by 114 deg, the
# simulated airspeed collapsed and TECS dove 19 m (verified with
# tools/ulog_mag.py and tools/ulog_yaw.py against Gazebo ground truth).
# The aircraft starts nose east on the runway, where the data is correct, so
# use the magnetometer only to initialise heading; in flight the EKF keeps
# yaw from GNSS velocity.
export PX4_PARAM_EKF2_MAG_TYPE=6


# --- Airspeed: Gazebo pitot instead of the EKF-derived simulated sensor -----
# sensor_airspeed_sim derives airspeed from the EKF estimate and only
# publishes when local position, global position and attitude all update in
# the same 8 Hz cycle. It froze at -1.4 m/s during a takeoff roll, so the
# runway takeoff never reached its rotation speed. The model now carries a
# Gazebo air_speed sensor (true airspeed from the physics), read by gz_bridge.
export PX4_PARAM_SENS_EN_ARSPDSIM=0