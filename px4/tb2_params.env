# PX4 parameter overrides for the TB2-class airframe.
#
# PX4 v1.17 applies every PX4_PARAM_<NAME>=<value> environment variable at
# boot (ROMFS/px4fmu_common/init.d-posix/rcS), on top of the base airframe
# 4003_gz_rc_cessna. This keeps the PX4 source tree unmodified.
#
# Sourced by scripts/run_sitl.sh.

# --- SITL environment (see scripts/fly_mission.py) --------------------------
export PX4_PARAM_NAV_DLL_ACT=0       # no GCS in SITL
export PX4_PARAM_FW_LND_USETER=0     # no distance sensor on the model
export PX4_PARAM_FW_LND_ABORT=0

# --- Performance model, from fw_aero (tools/glide_trim.py, hand calcs) ------
# Stall: V_s = sqrt(2 W / (rho S CL_max)) = sqrt(2*6374/(1.225*11*1.4)) = 26 m/s
# Level flight at 45 m/s, sea level: CL = 0.467, CD = 0.0366, D = 500 N
# Thrust = 1800 N * thr * (1 - 0.012*45) = 828 N * thr  ->  thr = 0.60
export PX4_PARAM_FW_AIRSPD_STALL=26
export PX4_PARAM_FW_AIRSPD_MIN=32
export PX4_PARAM_FW_AIRSPD_TRIM=45
export PX4_PARAM_FW_AIRSPD_MAX=60
export PX4_PARAM_FW_THR_TRIM=0.6


# --- Navigation scaled to a 45 m/s aircraft ---------------------------------
# Loiter radius for a 30 deg bank at trim speed:
#   R = V^2 / (g tan 30deg) = 45^2 / (9.81 * 0.577) = 358 m  ->  400 m
# (PX4 default 80 m would need a 69 deg bank at 45 m/s.)
export PX4_PARAM_NAV_LOITER_RAD=400
export PX4_PARAM_NAV_ACC_RAD=60      # ~1.3 s at 45 m/s (default 15 m)
export PX4_PARAM_MIS_TAKEOFF_ALT=50